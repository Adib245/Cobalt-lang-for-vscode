{
   "name": "cobalt-lang-for-vscode",
   "displayName": "Cobalt Lang for VSCode",
   "description": "An extension for the currently in the works Cobalt programming language",
   "version": "0.0.3",
   "icon": "assets/icon.png",
   "license": "MIT",
   "publisher": "Alec269",
   "repository": {
      "type": "git",
      "url": "https://github.com/Adib245/cobalt-lang-for-vscode.git"
   },
   "bugs": {
      "url": "https://github.com/Adib245/cobalt-lang-for-vscode/issues"
   },
   "author": {
      "name": "Nomayer Alam"
   },
   "contributors": [
      "Alec benjamin"
   ],
   "readme": "README.md",
   "engines": {
      "vscode": "^1.105.0"
   },
   "categories": [
      "Programming Languages",
      "Snippets"
   ],
   "main": "./client/out/extension",
   "contributes": {
      "configuration": {
         "type": "object",
         "title": "Example configuration",
         "properties": {
            "languageServerExample.maxNumberOfProblems": {
               "scope": "resource",
               "type": "number",
               "default": 100,
               "description": "Controls the maximum number of problems produced by the server."
            },
            "languageServerExample.trace.server": {
               "scope": "window",
               "type": "string",
               "enum": [
                  "off",
                  "messages",
                  "verbose"
               ],
               "default": "off",
               "description": "Traces the communication between VS Code and the language server."
            }
         }
      },
      "commands": [],
      "languages": [
         {
            "id": "cobalt",
            "aliases": [
               "Cobalt",
               "cobalt"
            ],
            "extensions": [
               ".cb",
               ".cbt",
               ".co",
               ".cobalt"
            ],
            "configuration": "./language-configuration.json"
         }
      ],
      "grammars": [
         {
            "language": "cobalt",
            "scopeName": "source.cobalt",
            "path": "./syntaxes/cobalt.tmLanguage.json"
         }
      ],
      "snippets": [
         {
            "language": "cobalt",
            "path": "./snippets/cobalt.code-snippets"
         }
      ],
      "iconThemes": [
         {
            "id": "cobalt-icon-theme",
            "label": "Cobalt File Icons",
            "path": "./icons/icon-theme.json"
         }
      ]
   },
   "activationEvents": [
      "onLanguage:cobalt"
   ],
   "scripts": {
      "vscode:prepublish": "npm run compile",
      "compile": "tsc -b",
      "watch": "tsc -b -w",
      "lint": "eslint",
      "postinstall": "cd client && npm install && cd ../server && npm install && cd ..",
      "test": "sh ./scripts/e2e.sh"
   },
   "devDependencies": {
      "@eslint/js": "^9.13.0",
      "@stylistic/eslint-plugin": "^2.9.0",
      "@types/mocha": "^10.0.6",
      "@types/node": "^22",
      "eslint": "^9.13.0",
      "mocha": "^12.0.0",
      "typescript": "^5.9.2",
      "typescript-eslint": "^8.39.0"
   },
   "overrides": {
      "serialize-javascript": "^7.0.2",
      "diff": "^7.0.0",
      "js-yaml": "^4.3.0",
      "minimatch": "^3.1.4"
   }
}
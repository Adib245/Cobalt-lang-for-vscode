{
   "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
   "name": "Cobalt",
   "scopeName": "source.cobalt",
   "patterns": [
      {
         "include": "#comments"
      },
      {
         "include": "#annotations"
      },
      {
         "include": "#interpolated-strings"
      },
      {
         "include": "#strings"
      },
      {
         "include": "#keywords"
      },
      {
         "include": "#types"
      },
      {
         "include": "#operators"
      },
      {
         "include": "#numbers"
      },
      {
         "include": "#functions"
      },
      {
         "include": "#symbols"
      },
      {
         "include": "#variables"
      }
   ],
   "repository": {
      "comments": {
         "patterns": [
            {
               "name": "comment.line.triple-slash.cobalt",
               "match": "///.*$"
            },
            {
               "name": "comment.line.double-slash.cobalt",
               "match": "//.*$"
            },
            {
               "name": "comment.block.cobalt",
               "begin": "/\\*",
               "end": "\\*/"
            }
         ]
      },
      "annotations": {
         "patterns": [
            {
               "name": "meta.annotation.cobalt",
               "match": "(@)([a-zA-Z_][a-zA-Z0-9_]*)",
               "captures": {
                  "1": {
                     "name": "keyword.operator.annotation.symbol.cobalt"
                  },
                  "2": {
                     "name": "entity.name.tag.annotation.cobalt"
                  }
               }
            }
         ]
      },
      "keywords": {
         "patterns": [
            {
               "name": "keyword.control.cobalt",
               "match": "\\b(if|else|while|for|in|return|try|throws)\\b"
            },
            {
               "name": "keyword.other.cobalt",
               "match": "\\b(import|struct|class|virtual|extends|impl|interface|template|type|unsafe|const|final|auto|public|private|protected|as|this)\\b"
            }
         ]
      },
      "types": {
         "patterns": [
            {
               "name": "storage.type.primitive.cobalt",
               "match": "\\b(void|byte|short|int|long|wide|float|double|quad|bool|strview|char|ichar|ubyte|ushort|uint|ulong|uwide|usize|isize)\\b"
            },
            {
               "name": "storage.type.generic.cobalt",
               "match": "\\b(vector|Iterable)\\b"
            },
            {
               "name": "entity.name.type.class.cobalt",
               "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
            }
         ]
      },
      "interpolated-strings": {
         "patterns": [
            {
               "name": "string.quoted.double.interpolated.cobalt",
               "begin": "(i)(\")",
               "beginCaptures": {
                  "1": {
                     "name": "keyword.other.string.prefix.cobalt"
                  },
                  "2": {
                     "name": "punctuation.definition.string.begin.cobalt"
                  }
               },
               "end": "\"",
               "endCaptures": {
                  "0": {
                     "name": "punctuation.definition.string.end.cobalt"
                  }
               },
               "patterns": [
                  {
                     "include": "#string-escapes"
                  },
                  {
                     "include": "#interpolated-placeholders"
                  }
               ]
            },
            {
               "name": "string.quoted.backtick.interpolated.cobalt",
               "begin": "`",
               "beginCaptures": {
                  "0": {
                     "name": "punctuation.definition.string.begin.cobalt"
                  }
               },
               "end": "`",
               "endCaptures": {
                  "0": {
                     "name": "punctuation.definition.string.end.cobalt"
                  }
               },
               "patterns": [
                  {
                     "include": "#string-escapes"
                  },
                  {
                     "include": "#interpolated-placeholders"
                  }
               ]
            }
         ]
      },
      "interpolated-placeholders": {
         "patterns": [
            {
               "name": "meta.embedded.line.cobalt",
               "begin": "\\$\\{",
               "end": "\\}",
               "beginCaptures": {
                  "0": {
                     "name": "punctuation.section.embedded.begin.cobalt"
                  }
               },
               "endCaptures": {
                  "0": {
                     "name": "punctuation.section.embedded.end.cobalt"
                  }
               },
               "patterns": [
                  {
                     "match": "(:)([^\\}]+)",
                     "captures": {
                        "1": {
                           "name": "punctuation.separator.format.cobalt"
                        },
                        "2": {
                           "name": "constant.other.format-specifier.cobalt"
                        }
                     }
                  },
                  {
                     "include": "$self"
                  }
               ]
            },
            {
               "name": "meta.embedded.format.cobalt",
               "begin": "\\{",
               "end": "\\}",
               "beginCaptures": {
                  "0": {
                     "name": "punctuation.section.embedded.begin.cobalt"
                  }
               },
               "endCaptures": {
                  "0": {
                     "name": "punctuation.section.embedded.end.cobalt"
                  }
               },
               "patterns": [
                  {
                     "match": "([a-zA-Z_][a-zA-Z0-9_]*)(?:(:)([^\\}]+))?",
                     "captures": {
                        "1": {
                           "name": "variable.other.interpolated.cobalt"
                        },
                        "2": {
                           "name": "punctuation.separator.format.cobalt"
                        },
                        "3": {
                           "name": "constant.other.format-specifier.cobalt"
                        }
                     }
                  }
               ]
            },
            {
               "name": "variable.other.interpolated.cobalt",
               "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
            }
         ]
      },
      "string-escapes": {
         "patterns": [
            {
               "name": "constant.character.escape.cobalt",
               "match": "\\\\."
            }
         ]
      },
      "strings": {
         "name": "string.quoted.double.cobalt",
         "begin": "\"",
         "end": "\"",
         "patterns": [
            {
               "include": "#string-escapes"
            }
         ]
      },
      "symbols": {
         "patterns": [
            {
               "name": "symbol.semicolon.cobalt",
               "match": ";"
            }
         ]
      },
      "operators": {
         "patterns": [
            {
               "name": "keyword.operator.range.cobalt",
               "match": "\\.\\."
            },
            {
               "name": "keyword.operator.access.standard",
               "match": "\\."
            },
            {
               "name": "keyword.operator.arithmetic.cobalt",
               "match": "(\\*{2}|\\+|\\-|\\*|/|%)"
            },
            {
               "name": "keyword.operator.pointer.cobalt",
               "match": "(\\^|\\*|\\$)"
            },
            {
               "name": "keyword.operator.assignment.cobalt",
               "match": "="
            },
            {
               "name": "keyword.operator.access.scoped.cobalt",
               "match": "::"
            },
            {
               "name": "keyword.operator.colon.cobalt",
               "match": ":"
            },
            {
               "name": "keyword.operator.reference.cobalt",
               "match": "&"
            }
         ]
      },
      "numbers": {
         "patterns": [
            {
               "name": "constant.numeric.cobalt",
               "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
            }
         ]
      },
      "functions": {
         "patterns": [
            {
               "name": "entity.name.function.cobalt",
               "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()"
            }
         ]
      },
      "variables": {
         "patterns": [
            {
               "name": "variable.placeholder.cobalt",
               "match": "\\_"
            },
            {
               "name": "variable.custom.cobalt",
               "match": "([a-zA-Z_][a-zA-Z0-9_]*)"
            }
         ]
      }
   }
}
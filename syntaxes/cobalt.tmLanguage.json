{
   "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
   "name": "Cobalt",
   "scopeName": "source.cobalt",
   "patterns": [
      {
         "include": "#expressions"
      },
      {
         "include": "#symbols"
      }
   ],
   "repository": {
      "expressions": {
         "patterns": [
            {
               "include": "#comments"
            },
            {
               "include": "#annotations"
            },
            {
               "include": "#interpolated-strings"
            },
            {
               "include": "#strings"
            },
            {
               "include": "#keywords"
            },
            {
               "include": "#types"
            },
            {
               "include": "#numbers"
            },
            {
               "include": "#functions"
            },
            {
               "include": "#named-parameters"
            },
            {
               "include": "#function-arguments"
            },
            {
               "include": "#operators"
            },
            {
               "include": "#variables"
            }
         ]
      },
      "comments": {
         "patterns": [
            {
               "name": "comment.line.directive.cobalt",
               "match": "^///%.*$",
               "captures": {
                  "0": {
                     "name": "meta.directive.comment.cobalt"
                  }
               }
            },
            {
               "name": "comment.line.triple-slash.cobalt",
               "match": "///.*$"
            },
            {
               "name": "comment.line.double-slash.cobalt",
               "match": "//.*$"
            },
            {
               "name": "comment.block.cobalt",
               "begin": "/\\*",
               "end": "\\*/"
            }
         ]
      },
      "annotations": {
         "patterns": [
            {
               "name": "meta.annotation.cobalt",
               "match": "(@)([a-zA-Z_][a-zA-Z0-9_]*)",
               "captures": {
                  "1": {
                     "name": "keyword.operator.annotation.symbol.cobalt"
                  },
                  "2": {
                     "name": "entity.name.tag.annotation.cobalt"
                  }
               }
            }
         ]
      },
      "keywords": {
         "patterns": [
            {
               "name": "keyword.control.cobalt",
               "match": "\\b(if|else|while|for|in|return|try|throws|match|break|continue|case|default|catch|loop|where)\\b"
            },
            {
               "name": "keyword.control.async.cobalt",
               "match": "\\b(async|await|yield)\\b"
            },
            {
               "name": "keyword.other.cobalt",
               "match": "\\b(fn|import|part|virtual|extends|impl|template|type|static|unsafe|const|final|auto|as|this|super|abstract|sealed|set|get|factory|export|extern|operator)\\b"
            },
            {
               "name": "keyword.control.access.modifier.cobalt",
               "match": "\\b(public|private|protected)\\b"
            },
            {
               "name": "keyword.construct.cobalt",
               "match": "\\b(struct|class|error|enum|interface)\\b"
            },
            {
               "name": "keyword.boolean.cobalt",
               "match": "\\b(true|false)\\b"
            }
         ]
      },
      "types": {
         "patterns": [
            {
               "name": "storage.type.primitive.cobalt",
               "match": "\\b(void|byte|short|int|long|wide|float|double|quad|bool|strview|char|ubyte|ushort|uint|ulong|uwide|usize|isize)\\b"
            },
            {
               "name": "meta.type.template.cobalt",
               "begin": "(\\b[A-Z][a-zA-Z0-9_]*\\b)(<)",
               "beginCaptures": {
                  "1": {
                     "name": "entity.name.type.class.cobalt"
                  },
                  "2": {
                     "name": "keyword.operator.template.left.angle.cobalt"
                  }
               },
               "end": ">",
               "endCaptures": {
                  "0": {
                     "name": "keyword.operator.template.right.angle.cobalt"
                  }
               },
               "patterns": [
                  {
                     "include": "#types"
                  },
                  {
                     "include": "#operators"
                  }
               ]
            },
            {
               "name": "entity.name.type.class.cobalt",
               "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
            }
         ]
      },
      "interpolated-strings": {
         "patterns": [
            {
               "name": "string.quoted.double.interpolated.cobalt",
               "begin": "(i)(\")",
               "beginCaptures": {
                  "1": {
                     "name": "keyword.other.string.prefix.cobalt"
                  },
                  "2": {
                     "name": "punctuation.definition.string.begin.cobalt"
                  }
               },
               "end": "\"",
               "endCaptures": {
                  "0": {
                     "name": "punctuation.definition.string.end.cobalt"
                  }
               },
               "patterns": [
                  {
                     "include": "#string-escapes"
                  },
                  {
                     "include": "#interpolated-placeholders"
                  }
               ]
            },
            {
               "name": "string.quoted.backtick.interpolated.cobalt",
               "begin": "`",
               "beginCaptures": {
                  "0": {
                     "name": "punctuation.definition.string.begin.cobalt"
                  }
               },
               "end": "`",
               "endCaptures": {
                  "0": {
                     "name": "punctuation.definition.string.end.cobalt"
                  }
               },
               "patterns": [
                  {
                     "include": "#string-escapes"
                  },
                  {
                     "include": "#interpolated-placeholders"
                  }
               ]
            }
         ]
      },
      "interpolated-placeholders": {
         "patterns": [
            {
               "name": "meta.embedded.line.cobalt",
               "begin": "\\$\\{",
               "end": "\\}",
               "beginCaptures": {
                  "0": {
                     "name": "punctuation.section.embedded.begin.cobalt"
                  }
               },
               "endCaptures": {
                  "0": {
                     "name": "punctuation.section.embedded.end.cobalt"
                  }
               },
               "patterns": [
                  {
                     "match": "(:)([^\\}]+)",
                     "captures": {
                        "1": {
                           "name": "punctuation.separator.format.cobalt"
                        },
                        "2": {
                           "name": "constant.other.format-specifier.cobalt"
                        }
                     }
                  },
                  {
                     "include": "$self"
                  }
               ]
            },
            {
               "name": "meta.embedded.format.cobalt",
               "begin": "\\{",
               "end": "\\}",
               "beginCaptures": {
                  "0": {
                     "name": "punctuation.section.embedded.begin.cobalt"
                  }
               },
               "endCaptures": {
                  "0": {
                     "name": "punctuation.section.embedded.end.cobalt"
                  }
               },
               "patterns": [
                  {
                     "match": "([a-zA-Z_][a-zA-Z0-9_]*)(?:(:)([^\\}]+))?",
                     "captures": {
                        "1": {
                           "name": "variable.other.interpolated.cobalt"
                        },
                        "2": {
                           "name": "punctuation.separator.format.cobalt"
                        },
                        "3": {
                           "name": "constant.other.format-specifier.cobalt"
                        }
                     }
                  }
               ]
            },
            {
               "name": "variable.other.interpolated.cobalt",
               "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
            }
         ]
      },
      "string-escapes": {
         "patterns": [
            {
               "name": "constant.character.escape.cobalt",
               "match": "\\\\."
            }
         ]
      },
      "strings": {
         "patterns": [
            {
               "name": "string.quoted.double.heap.cobalt",
               "begin": "(S)(\")",
               "beginCaptures": {
                  "1": {
                     "name": "keyword.other.string.prefix.cobalt"
                  },
                  "2": {
                     "name": "punctuation.definition.string.begin.cobalt"
                  }
               },
               "end": "\"",
               "endCaptures": {
                  "0": {
                     "name": "punctuation.definition.string.end.cobalt"
                  }
               },
               "patterns": [
                  {
                     "include": "#string-escapes"
                  }
               ]
            },
            {
               "name": "string.quoted.double.cobalt",
               "begin": "\"",
               "end": "\"",
               "patterns": [
                  {
                     "include": "#string-escapes"
                  }
               ]
            },
            {
               "name": "string.quoted.single.cobalt",
               "begin": "'",
               "end": "'",
               "patterns": [
                  {
                     "include": "#string-escapes"
                  }
               ]
            }
         ]
      },
      "symbols": {
         "patterns": [
            {
               "name": "symbol.semicolon.cobalt",
               "match": ";"
            }
         ]
      },
      "operators": {
         "patterns": [
            {
               "name": "keyword.operator.match.arrow.cobalt",
               "match": "=>"
            },
            {
               "name": "keyword.operator.range.cobalt",
               "match": "\\.\\.<|\\.\\."
            },
            {
               "name": "keyword.operator.dereference.postfix.cobalt",
               "match": "\\.\\^|\\.\\*"
            },
            {
               "name": "keyword.operator.access.standard.cobalt",
               "match": "\\."
            },
            {
               "name": "keyword.operator.pointer.cobalt",
               "match": "(\\^|\\*)"
            },
            {
               "name": "keyword.operator.anonymous.constructor.cobalt",
               "match": "\\$"
            },
            {
               "name": "keyword.operator.arithmetic.cobalt",
               "match": "(\\*{2}|\\+|\\-|\\*|/|%)"
            },
            {
               "name": "keyword.operator.assignment.cobalt",
               "match": "="
            },
            {
               "name": "keyword.operator.access.scoped.cobalt",
               "match": "::"
            },
            {
               "name": "keyword.operator.colon.cobalt",
               "match": ":"
            },
            {
               "name": "keyword.operator.reference.cobalt",
               "match": "&"
            }
         ]
      },
      "numbers": {
         "patterns": [
            {
               "name": "constant.numeric.cobalt",
               "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
            },
            {
               "name": "constant.numeric.hexadecimal.cobalt",
               "match": "\\b0[xX][0-9a-fA-F]+\\b"
            },
            {
               "name": "constant.numeric.octal.cobalt",
               "match": "\\b0[oO][0-7]+\\b"
            },
            {
               "name": "constant.numeric.binary.cobalt",
               "match": "\\b0[bB][01]+\\b"
            }
         ]
      },
      "functions": {
         "patterns": [
            {
               "name": "variable.parameter.field-binding.cobalt",
               "match": "\\b(this)(\\.)([a-zA-Z_][a-zA-Z0-9_]*)",
               "captures": {
                  "1": {
                     "name": "variable.language.this.cobalt"
                  },
                  "2": {
                     "name": "keyword.operator.access.standard.cobalt"
                  },
                  "3": {
                     "name": "variable.parameter.cobalt"
                  }
               }
            }
         ]
      },
      "function-arguments": {
         "begin": "\\b(?!(?:auto|if|else|while|for|in|return|try|throws|match|break|continue|case|default|catch|loop|async|await|yield|fn|import|part|virtual|extends|impl|template|type|static|unsafe|const|final|as|this|super|abstract|sealed|set|get|factory|export|extern|operator)\\b)([a-z_][a-zA-Z0-9_]*)\\s*(\\()",
         "beginCaptures": {
            "1": {
               "name": "entity.name.function.cobalt"
            },
            "2": {
               "name": "punctuation.definition.arguments.begin.cobalt"
            }
         },
         "end": "\\)",
         "endCaptures": {
            "0": {
               "name": "punctuation.definition.arguments.end.cobalt"
            }
         },
         "patterns": [
            {
               "include": "#named-parameters"
            },
            {
               "include": "#expressions"
            }
         ]
      },
      "named-parameters": {
         "patterns": [
            {
               "name": "meta.parameter.named.cobalt",
               "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(:)(?![:=])",
               "captures": {
                  "1": {
                     "name": "variable.parameter.named.cobalt"
                  },
                  "2": {
                     "name": "punctuation.separator.key-value.cobalt"
                  }
               }
            }
         ]
      },
      "variables": {
         "patterns": [
            {
               "name": "variable.placeholder.cobalt",
               "match": "\\_"
            },
            {
               "name": "variable.custom.cobalt",
               "match": "([a-zA-Z_][a-zA-Z0-9_]*)"
            }
         ]
      }
   }
}